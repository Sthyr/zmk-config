#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ---------------------------------------------------------------------------------------------------------------------------------------
// |         |      |       |         |         |       |               |       |          |    '    |    "     |      ¡      |      !      |
// |  GUI    |  Q   |   W   |   F     |    P    |   B   |               |   J   |    L     |    U    |    Y     |      ¿      |      ?      |
// |  CTRL   |  A   |   R   |   S     |    T    |   G   |               |   M   |    N     |    E    |    I     |      O      |      ´      |
// |  SHIFT  |  Z   |   X   |   C     |    D    |   V   |     |   |     |   K   |    H     |    Ñ    |    ,     |      .      |      -      |
//                          |  CTRL   |   SPC   |  TAB  |     |   |     | ENTER |   BSPC   |   DEL   |                                       
bindings = <                                                                                                                  
    &none     &none  &none   &none     &none     &none                   &none   &none      &kp MINUS &kp LS(N2) &kp LS(EQUAL) &kp LS(N1)
    &kp LGUI  &kp Q  &kp W   &kp F     &kp P     &kp B                   &kp J   &kp L      &kp U     &kp Y      &kp EQUAL     &kp LS(MINUS)
    &kp LCTRL &kp A  &kp R   &kp S     &kp T     &kp G                   &kp M   &kp N      &kp E     &kp I      &kp O         &kp LBKT
    &kp LSHFT &kp Z  &kp X   &kp C     &kp D     &kp V   &none     &none &kp K   &kp H      &kp SEMI  &kp COMMA  &kp DOT       &kp SLASH
                             &kp LCTRL &kp SPACE &kp TAB &none     &none &kp RET &lt 2 BSPC &kp DEL
            >;
        };

        nav_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  Up   |  F10 |  F11  |  F12  |
// |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   | Left  |  Down |Right |   )   |   ~   |
// |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3 &bt BT_SEL 4                 &trans    &trans    &trans    &trans    &trans    &trans
&kp F1     &kp F2           &kp F3            &kp F4            &kp F5       &kp F6                       &kp F7    &kp F8    &kp UP    &kp F10   &kp F11   &kp F12
&kp GRAVE  &kp EXCL         &kp AT            &kp HASH          &kp DOLLAR   &kp PRCNT                    &kp CARET &kp LEFT  &kp DOWN  &kp RIGHT &kp RPAR  &kp TILDE
&trans     &ext_power EP_ON &ext_power EP_OFF &ext_power EP_TOG &trans       &trans    &none     &none    &trans    &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE
                                              &trans            &trans       &trans    &none     &none    &trans    &trans    &trans
            >;
        };

        symbols_layer {
// ---------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |          |         |            |             |                |                |               |                 |              |         |        |      |      |
// |          |         |     !      |      _      |  (             |  )             |               |        /        |      ~       |    @    |   &    |      |      |
// |          |    <    |     >      |      =      |  {             |  }             |               |        \        |      |       |    #    |   $    |      |      |
// |    /     |    -    |     +      |      *      |  [             |  ]             |     |   |     |                 |              |    ^    |        |      |      |
//                                   |             |                |                |     |   |     |                 |              |         |                              
            bindings = <                                                                                                                                                
    &trans     &trans    &trans       &trans        &trans           &trans                           &trans            &trans         &trans    &trans   &trans &trans
    &trans     &trans    &kp LS(N1)   &kp LS(SLASH) &kp LS(N8)       &kp LS(N9)                       &kp LS(N7)        &kp LC(RA(N4)) &kp AT    &kp AMPS &trans &trans
    &trans     &kp NUBS  &kp LS(NUBS) &kp LS(N0)    &kp LBRC         &kp RBRC                         &kp LC(RA(GRAVE)) &kp LC(RA(N1)) &kp HASH  &kp DLLR &trans &trans
    &kp LS(N7) &kp SLASH &kp RBRC     &kp LS(RBRC)  &kp LC(RA(LBKT)) &kp LC(RA(RBKT)) &none     &none &trans            &trans         &kp CARET &trans   &trans &trans
                                      &trans        &trans           &trans           &none     &none &trans            &trans         &trans
            >;
        };
    };
};
